  "caveats": [
    {
      "id": "total-retries-unit",
      "annotation": "The source docstring describes total as the number of retries, not the total number of attempts.",
      "evidence": {
        "quote": "    :param int total:\n        Total number of retries to allow. Takes precedence over other counts.\n\n        Set to ``None`` to remove this constraint and fall back on other\n        counts.\n\n        Set to ``0`` to fail on the first retry.\n\n        Set to ``False`` to disable and imply ``raise_on_redirect=False``.",
        "sha256": "5ddb754504d7333ba59f9da3710fc8fda8874e5ce1d9c498c138b22129649fef",
